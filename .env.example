# ==============================================================================
# TranslaterAny - Configurações de Ambiente (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PERFIL DE EXECUÇÃO
# ------------------------------------------------------------------------------
# - "local": Utiliza Ollama localmente (translategemma:12b e gemma4:12b) - Custo $0.00
# - "nuvem": Utiliza provedores em nuvem (Google Gemini ou OpenAI)
# - "hibrido": Combina modelos (ex: tradução local + revisão em nuvem)
TRANSLATERANY_LLM_PROFILE=nuvem

# ------------------------------------------------------------------------------
# 2. FLUXO MULTI-MODELO (Modelos por Função)
# ------------------------------------------------------------------------------
# Modelo para TRADUÇÃO (translate_dialogue, translate_signs, translate_songs):
# Sugestões: gemini-2.5-flash, gpt-4o-mini, translategemma:12b (local)
TRANSLATERANY_MODEL_TRANSLATE=gemini-2.5-flash

# Modelo para REVISÃO E ESTILO (review_meaning, colloquial, adapt, final_readthrough):
# Sugestões: gemini-2.5-flash, gemini-1.5-pro, gpt-4o, gpt-4o-mini, gemma4:12b (local)
TRANSLATERANY_MODEL_REVIEW=gemini-2.5-flash

# (Opcional) Sobrescrita específica para uma etapa crítica:
# TRANSLATERANY_STAGE_FINAL_READTHROUGH_MODEL=gpt-4o
# TRANSLATERANY_STAGE_SCENE_ANALYSIS_MODEL=gemini-1.5-pro

# ------------------------------------------------------------------------------
# 3. CHAVES DE API (PROVEDORES EM NUVEM)
# ------------------------------------------------------------------------------
# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 4. RACIOCÍNIO / THINKING DOS MODELOS
# ------------------------------------------------------------------------------
# Controla o raciocínio intermediário dos modelos (thinking mode).
# - false: desativa o raciocínio intermediário (máxima velocidade, 0 tokens de thinking, menor custo)
# - true: ativa o raciocínio intermediário
TRANSLATERANY_LLM_THINK=false

# ------------------------------------------------------------------------------
# 5. SERVIÇOS LOCAIS (Opcional - já possuem valores padrão inteligentes)
# ------------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
# LANGUAGETOOL_URL=http://localhost:8010/v2/check

